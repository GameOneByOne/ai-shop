{
  "manifest_version": 3,
  "name": "AI 店长 1688 采集桥",
  "version": "0.2.5",
  "description": "将当前已登录的 1688 搜索结果低频导入本地 AI 店长。",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://1688.com/*",
    "https://*.alibaba.com/*",
    "https://*.taobao.com/*",
    "http://localhost:3000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
